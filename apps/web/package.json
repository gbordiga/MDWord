{
  "name": "@mdword/web",
  "version": "0.1.6",
  "private": true,
  "scripts": {
    "copy-paged": "node ./scripts/copy-paged.mjs",
    "dev": "node ./scripts/free-port.mjs 3000 && node ./scripts/copy-paged.mjs && next dev --webpack --port 3000",
    "build": "node ./scripts/copy-paged.mjs && next build --webpack",
    "start": "next start",
    "lint": "node -e \"console.log('next lint was removed in Next 16; run pnpm typecheck instead')\"",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@mdword/document-model": "workspace:*",
    "@mdword/editor": "workspace:*",
    "@mdword/indexer": "workspace:*",
    "@mdword/layout-engine": "workspace:*",
    "@mdword/markdown-serializer": "workspace:*",
    "@mdword/myst-parser": "workspace:*",
    "@mdword/plugin-sdk": "workspace:*",
    "@mdword/renderer": "workspace:*",
    "@mdword/shared": "workspace:*",
    "@mdword/source-editor": "workspace:*",
    "@mdword/ui": "workspace:*",
    "@mdword/workspace": "workspace:*",
    "@tiptap/react": "^3.31.3",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.47.0",
    "next": "^16.3.6",
    "pagedjs": "^0.4.3",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.13.2",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
