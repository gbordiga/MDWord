{
  "name": "@mdword/desktop",
  "version": "0.1.15",
  "private": true,
  "license": "MIT",
  "description": "MDWord desktop shell",
  "desktopName": "MDWord",
  "author": "Giacomo Bordiga <gbordiga@gmail.com>",
  "homepage": "https://github.com/gbordiga/MDWord",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "icons": "node scripts/build-icons.mjs",
    "build": "node scripts/build-icons.mjs && node scripts/build.mjs",
    "dist": "node scripts/build-icons.mjs && node scripts/build.mjs && electron-builder --config electron-builder.yml --publish never",
    "dist:publish": "node scripts/build-icons.mjs && node scripts/build.mjs && electron-builder --config electron-builder.yml --publish always",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdword/renderer": "workspace:*",
    "@mdword/shared": "workspace:*",
    "electron-updater": "^6.8.11",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "sharp": "0.35.5",
    "typescript": "^7.0.2"
  }
}
