{
  "name": "mdword",
  "version": "0.1.4",
  "private": true,
  "description": "MDWord — a semantic-first structured document editor with MyST Markdown as the source of truth.",
  "license": "MIT",
  "author": "Giacomo Bordiga",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @mdword/web dev",
    "dev:web": "pnpm --filter @mdword/web dev",
    "dev:desktop": "pnpm --filter @mdword/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @mdword/web build",
    "build:desktop": "pnpm --filter @mdword/desktop build",
    "dist": "node scripts/dist-desktop.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @mdword/web test:e2e",
    "mobile:sync": "pnpm build:web && pnpm --filter @mdword/mobile icons && pnpm --filter @mdword/mobile sync && pnpm --filter @mdword/mobile patch-native",
    "mobile:android": "pnpm --filter @mdword/mobile open:android",
    "mobile:ios": "pnpm --filter @mdword/mobile open:ios",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "electron", "electron-winstaller", "sharp"],
    "overrides": {
      "sharp": "^0.35.4",
      "postcss": "8.5.28",
      "linkify-it": "5.0.2",
      "markdown-it@14": "14.3.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "csv-parse": "7.0.2"
    }
  }
}
