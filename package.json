{
  "name": "mdword",
  "version": "0.1.7",
  "private": true,
  "description": "MDWord — a semantic-first structured document editor with MyST Markdown as the source of truth.",
  "license": "MIT",
  "author": "Giacomo Bordiga",
  "packageManager": "pnpm@10.33.3",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @mdword/web dev",
    "dev:web": "pnpm --filter @mdword/web dev",
    "dev:desktop": "pnpm --filter @mdword/desktop dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @mdword/web build",
    "build:desktop": "pnpm --filter @mdword/desktop build",
    "dist": "node scripts/dist-desktop.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm --filter @mdword/web test:e2e",
    "mobile:sync": "pnpm build:web && pnpm --filter @mdword/mobile icons && pnpm --filter @mdword/mobile sync && pnpm --filter @mdword/mobile patch-native",
    "mobile:android": "pnpm --filter @mdword/mobile open:android",
    "mobile:ios": "pnpm --filter @mdword/mobile open:ios",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r --if-present clean && rm -rf node_modules"
  },
  "devDependencies": {
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "electron-winstaller",
      "sharp"
    ],
    "overrides": {
      "sharp": "0.35.5",
      "postcss": "8.5.28",
      "linkify-it": "5.0.2",
      "lodash": "4.18.1",
      "lodash-es": "4.18.1",
      "csv-parse": "7.0.2",
      "uuid@7": "11.1.1",
      "dompurify": "3.4.17",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.6",
      "brace-expansion@5": "5.0.12",
      "electron": "44.9.1",
      "http-cache-semantics": "4.3.0",
      "source-map-js": "1.2.2",
      "undici@6": "6.29.1",
      "undici@7": "7.30.1",
      "vite": "7.3.7",
      "zod": "4.6.6",
      "markdown-it": "14.3.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "markdown-it": "14"
      }
    },
    "patchedDependencies": {
      "markdown-it-dollarmath@0.5.0": "patches/markdown-it-dollarmath@0.5.0.patch"
    }
  }
}
